<?xml version="1.0" encoding="utf-8"?>
<!-- 누르면 2dp 내려가고, 꺼지면 흐려진다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <set>
            <objectAnimator
                android:duration="0"
                android:propertyName="alpha"
                android:valueTo="0.55"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="0"
                android:propertyName="translationY"
                android:valueTo="0dp"
                android:valueType="floatType" />
        </set>
    </item>
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="0"
                android:propertyName="alpha"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="0"
                android:propertyName="translationY"
                android:valueTo="2dp"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="0"
                android:propertyName="alpha"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="0"
                android:propertyName="translationY"
                android:valueTo="0dp"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
