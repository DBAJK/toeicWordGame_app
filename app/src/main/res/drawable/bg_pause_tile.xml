<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_dark">
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item android:bottom="2dp" android:top="1dp">
                        <shape>
                            <solid android:color="#A9A08E" />
                            <corners android:radius="14dp" />
                        </shape>
                    </item>
                    <item android:bottom="3dp">
                        <shape>
                            <gradient android:angle="270" android:endColor="#E9E2D2" android:startColor="#FFFDF7" />
                            <stroke android:width="1dp" android:color="@color/edge" />
                            <corners android:radius="14dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item android:top="3dp">
                        <shape>
                            <solid android:color="@color/drop_shadow" />
                            <corners android:radius="14dp" />
                        </shape>
                    </item>
                    <item android:bottom="1dp" android:top="2dp">
                        <shape>
                            <solid android:color="#A9A08E" />
                            <corners android:radius="14dp" />
                        </shape>
                    </item>
                    <item android:bottom="3dp">
                        <shape>
                            <gradient android:angle="270" android:endColor="#E9E2D2" android:startColor="#FFFDF7" />
                            <stroke android:width="1dp" android:color="@color/edge" />
                            <corners android:radius="14dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
