<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <gradient android:angle="270" android:endColor="@color/gold" android:startColor="@color/gold_light" />
                    <stroke android:width="1dp" android:color="#995A2F00" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#474747" />
                    <stroke android:width="1dp" android:color="@color/edge" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
