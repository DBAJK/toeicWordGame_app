<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#24170C" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:angle="270" android:endColor="#5FA52E" android:startColor="#A6E05F" />
            </shape>
        </clip>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#8A6A3E" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
