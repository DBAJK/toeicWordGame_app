<?xml version="1.0" encoding="utf-8"?>
<!-- 아래 버튼 바. 가로 화면은 버튼을 한 줄에 놓는다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_main_bar"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <Button
        android:id="@+id/openDictionary"
        style="@style/ToeicButton.Gray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_dictionary" />

    <Button
        android:id="@+id/showRecords"
        style="@style/ToeicButton.Gray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/show_records" />
</LinearLayout>
