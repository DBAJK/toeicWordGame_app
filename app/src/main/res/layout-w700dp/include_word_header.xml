<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/word_header"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/ToeicWordHeader"
        android:layout_width="64dp"
        android:text="@string/column_number" />

    <TextView
        style="@style/ToeicWordHeader"
        android:layout_width="0dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1.1"
        android:text="@string/column_word" />

    <TextView
        android:id="@+id/meaningHeader"
        style="@style/ToeicWordHeader"
        android:layout_width="0dp"
        android:layout_marginStart="6dp"
        android:layout_weight="2"
        android:text="@string/column_meaning" />

    <TextView
        style="@style/ToeicWordHeader"
        android:layout_width="0dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:text="@string/column_note" />

    <TextView
        style="@style/ToeicWordHeader"
        android:layout_width="36dp"
        android:layout_marginStart="6dp"
        android:text="@string/column_star" />

    <TextView
        style="@style/ToeicWordHeader"
        android:layout_width="36dp"
        android:layout_marginStart="6dp"
        android:text="@string/column_memorized" />
</LinearLayout>
