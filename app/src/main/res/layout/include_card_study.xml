<?xml version="1.0" encoding="utf-8"?>
<!-- 카드 학습: 앞면과 뒷면을 겹쳐 두고, 뒤집을 때 절반에서 바꾼다. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/previous"
                style="@style/ToeicButton.Circle"
                android:layout_width="44dp"
                android:layout_height="47dp"
                android:contentDescription="@string/card_previous"
                android:text="@string/card_prev_symbol"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/card"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/card"
                android:layout_width="0dp"
                android:layout_height="240dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                tools:ignore="KeyboardInaccessibleWidget"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/next"
                app:layout_constraintStart_toEndOf="@id/previous"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/card_max_width">

                <FrameLayout
                    android:id="@+id/front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_front">

                    <TextView
                        android:id="@+id/frontMeta"
                        style="@style/ToeicCardMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="48dp"
                        tools:text="12p · No.1024 · ★★★" />

                    <TextView
                        android:id="@+id/frontMarks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="16dp"
                        android:textColor="#B8860B"
                        android:textSize="19sp"
                        tools:text="★✓" />

                    <TextView
                        android:id="@+id/frontMain"
                        style="@style/ToeicCardMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        tools:text="achieve" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="16dp"
                        android:text="@string/card_flip"
                        android:textColor="#A89C90"
                        android:textSize="12sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_back"
                    android:rotationY="180"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/backMeta"
                        style="@style/ToeicCardMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="48dp"
                        tools:text="achieve" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:id="@+id/backMain"
                            style="@style/ToeicCardMain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="성취하다" />

                        <TextView
                            android:id="@+id/backNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textColor="@color/muted"
                            android:textSize="14sp"
                            tools:text="동사 · 빈출" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <Button
                android:id="@+id/next"
                style="@style/ToeicButton.Circle"
                android:layout_width="44dp"
                android:layout_height="47dp"
                android:contentDescription="@string/card_next"
                android:text="@string/card_next_symbol"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/card"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.toeicword.app.ui.widget.FlowRowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:centerRows="true"
            app:horizontalGap="8dp"
            app:verticalGap="6dp">

            <TextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/panel_text"
                android:textSize="17sp"
                tools:text="1 / 3,037" />

            <TextView
                android:id="@+id/star"
                style="@style/ToeicMark.Star"
                android:contentDescription="@string/column_star"
                android:text="@string/mark_star" />

            <TextView
                android:id="@+id/memorized"
                style="@style/ToeicMark.Check"
                android:contentDescription="@string/column_memorized"
                android:text="@string/mark_check" />

            <com.toeicword.app.ui.widget.RoundedLinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seg_group"
                android:foreground="@drawable/fg_seg_group"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wordFirst"
                    style="@style/ToeicSegItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_word_first" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/panel_dark" />

                <TextView
                    android:id="@+id/meaningFirst"
                    style="@style/ToeicSegItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_meaning_first" />
            </com.toeicword.app.ui.widget.RoundedLinearLayout>

            <com.toeicword.app.ui.widget.RoundedLinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seg_group"
                android:foreground="@drawable/fg_seg_group"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inOrder"
                    style="@style/ToeicSegItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_in_order" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/panel_dark" />

                <TextView
                    android:id="@+id/shuffle"
                    style="@style/ToeicSegItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/card_shuffle" />
            </com.toeicword.app.ui.widget.RoundedLinearLayout>
        </com.toeicword.app.ui.widget.FlowRowLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
