<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        style="@style/ToeicRecordHeader"
        android:layout_weight="0.7"
        android:text="@string/records_rank" />

    <TextView
        style="@style/ToeicRecordHeader"
        android:layout_marginStart="4dp"
        android:layout_weight="1.1"
        android:text="@string/records_mode" />

    <TextView
        style="@style/ToeicRecordHeader"
        android:layout_marginStart="4dp"
        android:layout_weight="1.9"
        android:text="@string/records_range" />

    <TextView
        style="@style/ToeicRecordHeader"
        android:layout_marginStart="4dp"
        android:layout_weight="0.7"
        android:text="@string/records_stage" />

    <TextView
        style="@style/ToeicRecordHeader"
        android:layout_marginStart="4dp"
        android:layout_weight="1.1"
        android:text="@string/records_score" />

    <TextView
        style="@style/ToeicRecordHeader"
        android:layout_marginStart="4dp"
        android:layout_weight="1.4"
        android:text="@string/records_date" />
</LinearLayout>
