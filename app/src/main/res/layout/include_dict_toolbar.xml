<?xml version="1.0" encoding="utf-8"?>
<com.toeicword.app.ui.widget.FlowRowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:horizontalGap="8dp"
    app:verticalGap="6dp">

    <com.toeicword.app.ui.widget.RoundedLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_seg_group"
        android:foreground="@drawable/fg_seg_group"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/viewList"
            style="@style/ToeicSegItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_list" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/panel_dark" />

        <TextView
            android:id="@+id/viewCard"
            style="@style/ToeicSegItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_card" />
    </com.toeicword.app.ui.widget.RoundedLinearLayout>

    <TextView
        android:id="@+id/hideMeanings"
        style="@style/ToeicChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hide_meanings" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/panel_muted"
        android:textSize="14sp"
        tools:text="3,037개 · ★ 0 · ✓ 0" />
</com.toeicword.app.ui.widget.FlowRowLayout>
