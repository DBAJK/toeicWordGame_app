<?xml version="1.0" encoding="utf-8"?>
<!-- 하단 바(세로 화면): 위 줄에 점수·게이지·단계, 아래 줄에 입력창 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_bar"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/score"
            android:textColor="@color/sand"
            android:textSize="14sp" />

        <com.toeicword.app.ui.widget.OutlinedTextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/score_yellow"
            android:textSize="24sp"
            app:outlineColor="@color/score_outline"
            app:outlineWidth="2dp"
            app:textDepth="2dp"
            tools:text="1,280" />

        <ProgressBar
            android:id="@+id/gauge"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="44dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/gauge_progress" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/stagePill"
            layout="@layout/include_stage_pill" />

        <Button
            android:id="@+id/exit"
            style="@style/ToeicButton.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/exit"
            android:text="@string/exit_short" />
    </LinearLayout>

    <EditText
        android:id="@+id/answer"
        style="@style/ToeicInput"
        tools:ignore="Autofill"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_answer"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="19sp"
        android:hint="@string/answer_hint_en" />
</LinearLayout>
