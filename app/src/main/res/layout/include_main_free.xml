<?xml version="1.0" encoding="utf-8"?>
<!-- 자유 연습: 페이지 범위를 골라 바로 시작한다. -->
<com.toeicword.app.ui.widget.FlowRowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_free_practice"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    app:centerRows="true"
    app:horizontalGap="8dp"
    app:verticalGap="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/free_practice"
        android:textColor="@color/sand"
        android:textSize="15sp" />

    <include
        android:id="@+id/pageRange"
        layout="@layout/include_page_range" />

    <Button
        android:id="@+id/start"
        style="@style/ToeicButton.Gray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="시작 (3,037개)" />
</com.toeicword.app.ui.widget.FlowRowLayout>
