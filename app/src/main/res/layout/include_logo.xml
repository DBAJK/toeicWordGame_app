<?xml version="1.0" encoding="utf-8"?>
<!-- 한컴 로고처럼 주황빛 입체 글씨, 살짝 기울임 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:rotation="-2">

    <com.toeicword.app.ui.widget.OutlinedTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logo_big"
        android:textSize="@dimen/logo_big"
        app:blackWeight="true"
        app:logoFill="true"
        app:outlineColor="#6B2A00"
        app:outlineWidth="2dp"
        app:textDepth="4dp" />

    <com.toeicword.app.ui.widget.OutlinedTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/logo_small"
        android:textSize="@dimen/logo_small"
        app:blackWeight="true"
        app:logoFill="true"
        app:outlineColor="#6B2A00"
        app:outlineWidth="2dp"
        app:textDepth="4dp" />
</LinearLayout>
